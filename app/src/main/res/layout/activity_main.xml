<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:text="🚀 AUTO PINGER"
            android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:letterSpacing="0.15" android:layout_marginTop="10dp"
            android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <TextView android:text="Premium Website Monitor"
            android:textSize="12sp" android:textColor="#B0FFFFFF" android:letterSpacing="0.1"
            android:layout_gravity="center" android:layout_marginBottom="14dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <com.autopinger.RainbowLoaderView android:id="@+id/loader"
            android:layout_width="160dp" android:layout_height="160dp"
            android:layout_gravity="center" android:layout_marginBottom="12dp"/>

        <!-- LIVE STATUS -->
        <LinearLayout android:orientation="horizontal" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <View android:id="@+id/liveDot" android:layout_width="14dp" android:layout_height="14dp"
                android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvLiveStatus" android:text="● OFFLINE"
                android:textColor="#90FFFFFF" android:textSize="14sp" android:textStyle="bold"
                android:letterSpacing="0.1" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/tvStatus" android:text="Ready to start"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:gravity="center" android:layout_marginBottom="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- URL INPUT -->
        <TextView android:text="🌐 Website URL" android:textColor="#90FFFFFF"
            android:textSize="12sp" android:layout_marginStart="4dp" android:layout_marginBottom="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etUrl" android:hint="https://example.com"
            android:textColorHint="#60FFFFFF" android:textColor="#FFFFFF" android:textSize="14sp"
            android:padding="14dp" android:background="@drawable/input_bg"
            android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- INTERVAL + DURATION -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <LinearLayout android:orientation="vertical" android:layout_weight="1"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp">
                <TextView android:text="⏱️ Interval" android:textColor="#90FFFFFF"
                    android:textSize="11sp" android:layout_marginStart="4dp" android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spInterval" android:background="@drawable/spinner_bg"
                    android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_weight="1"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp">
                <TextView android:text="📅 Duration" android:textColor="#90FFFFFF"
                    android:textSize="11sp" android:layout_marginStart="4dp" android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Spinner android:id="@+id/spDuration" android:background="@drawable/spinner_bg"
                    android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TELEGRAM TOGGLE -->
        <LinearLayout android:id="@+id/tgToggle" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/tg_toggle_bg" android:padding="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
            <TextView android:text="📨  Telegram Notifications  (Tap to open)"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tgSection" android:orientation="vertical"
            android:visibility="gone" android:background="@drawable/card_bg" android:padding="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <EditText android:id="@+id/etTgToken" android:hint="Bot Token (123456:ABC...)"
                android:textColorHint="#60FFFFFF" android:textColor="#FFFFFF" android:textSize="12sp"
                android:padding="10dp" android:background="@drawable/input_bg" android:inputType="text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etTgChat" android:hint="Chat ID (जैसे 123456789)"
                android:textColorHint="#60FFFFFF" android:textColor="#FFFFFF" android:textSize="12sp"
                android:padding="10dp" android:background="@drawable/input_bg" android:inputType="numberSigned"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
            <TextView android:text="💡 Bot banao @BotFather se, Chat ID lo @userinfobot se"
                android:textColor="#80FFFFFF" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- START / STOP -->
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="14dp">
            <Button android:id="@+id/btnStart" android:text="▶ START" android:textColor="#FFFFFF"
                android:textStyle="bold" android:background="@drawable/btn_gradient"
                android:layout_weight="1" android:layout_width="0dp" android:layout_height="54dp"
                android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnStop" android:text="■ STOP" android:textColor="#FFFFFF"
                android:textStyle="bold" android:background="@drawable/btn_stop"
                android:layout_weight="1" android:layout_width="0dp" android:layout_height="54dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- INFO CARD -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView android:text="📊  LIVE STATS" android:textColor="#FF00F0FF"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvWebsiteName" android:text="Website: —"
                android:textColor="#FFFFFF" android:textSize="13sp" android:paddingTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvUptime" android:text="Uptime: 0%  |  Pings: 0  |  Success: 0"
                android:textColor="#D0FFFFFF" android:textSize="12sp" android:paddingTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvExpiry" android:text="Expires in: —"
                android:textColor="#FFB0C4FF" android:textSize="12sp" android:paddingTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvNextPing" android:text="Next ping: —"
                android:textColor="#FF00E676" android:textSize="12sp" android:paddingTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/tvInfo"
            android:text="URL dalo, Duration choose karo, START dabao.\nHar ping pe Telegram pe notification jayegi (agar set kiya ho)."
            android:textColor="#D0FFFFFF" android:textSize="12sp" android:lineSpacingExtra="4dp"
            android:padding="14dp" android:background="@drawable/card_bg"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
