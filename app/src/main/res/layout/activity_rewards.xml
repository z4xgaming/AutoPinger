<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView android:text="💰 REWARDS" android:textSize="26sp" android:textStyle="bold"
            android:textColor="#FFD700" android:letterSpacing="0.2" android:layout_gravity="center"
            android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Earn • Redeem • Enjoy"
            android:textSize="11sp" android:textColor="#90FFD700" android:layout_gravity="center"
            android:layout_marginBottom="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- WALLET CARD -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/black_gold_card"
            android:padding="22dp" android:gravity="center" android:layout_marginBottom="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="💎 WALLET BALANCE" android:textColor="#FFD700"
                android:textSize="11sp" android:letterSpacing="0.2" android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvCoins" android:text="0"
                android:textColor="#FFD700" android:textSize="60sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="COINS" android:textColor="#90FFD700" android:textSize="11sp"
                android:letterSpacing="0.3" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvTotalEarned" android:text="Total: 0"
                android:textColor="#B0FFD700" android:textSize="11sp" android:layout_marginTop="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvStreak" android:text="🔥 0 day streak"
                android:textColor="#FF6B00" android:textSize="13sp" android:textStyle="bold"
                android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- DAILY SPIN -->
        <Button android:id="@+id/btnDailySpin" android:text="🎡 DAILY SPIN"
            android:textColor="#000000" android:textStyle="bold" android:textSize="15sp"
            android:background="@drawable/coin_gold"
            android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvDailyTimer" android:text=""
            android:textColor="#90FFD700" android:textSize="11sp" android:gravity="center"
            android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- SCRATCH CARD -->
        <Button android:id="@+id/btnScratch" android:text="🎰 SCRATCH CARD"
            android:textColor="#000000" android:textStyle="bold" android:textSize="15sp"
            android:background="@drawable/coin_gold"
            android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvScratchTimer" android:text=""
            android:textColor="#90FFD700" android:textSize="11sp" android:gravity="center"
            android:layout_marginBottom="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- REDEEM -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/black_gold_card"
            android:padding="16dp" android:layout_marginBottom="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="🕐 REDEEM MONITORING TIME" android:textColor="#FFD700"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:text="1 Hour" android:textColor="#FFFFFF" android:textSize="14sp"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:text="100 💎" android:textColor="#FFD700" android:textSize="13sp"
                    android:layout_marginEnd="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnR1h" android:text="GET" android:textColor="#000000"
                    android:textSize="11sp" android:textStyle="bold" android:background="@drawable/coin_gold"
                    android:minWidth="0dp" android:paddingHorizontal="18dp"
                    android:layout_width="wrap_content" android:layout_height="38dp"/>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:text="6 Hours" android:textColor="#FFFFFF" android:textSize="14sp"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:text="500 💎" android:textColor="#FFD700" android:textSize="13sp"
                    android:layout_marginEnd="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnR6h" android:text="GET" android:textColor="#000000"
                    android:textSize="11sp" android:textStyle="bold" android:background="@drawable/coin_gold"
                    android:minWidth="0dp" android:paddingHorizontal="18dp"
                    android:layout_width="wrap_content" android:layout_height="38dp"/>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:text="1 Day" android:textColor="#FFFFFF" android:textSize="14sp"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:text="1500 💎" android:textColor="#FFD700" android:textSize="13sp"
                    android:layout_marginEnd="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnR1d" android:text="GET" android:textColor="#000000"
                    android:textSize="11sp" android:textStyle="bold" android:background="@drawable/coin_gold"
                    android:minWidth="0dp" android:paddingHorizontal="18dp"
                    android:layout_width="wrap_content" android:layout_height="38dp"/>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:text="7 Days" android:textColor="#FFFFFF" android:textSize="14sp"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:text="8000 💎" android:textColor="#FFD700" android:textSize="13sp"
                    android:layout_marginEnd="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnR7d" android:text="GET" android:textColor="#000000"
                    android:textSize="11sp" android:textStyle="bold" android:background="@drawable/coin_gold"
                    android:minWidth="0dp" android:paddingHorizontal="18dp"
                    android:layout_width="wrap_content" android:layout_height="38dp"/>
            </LinearLayout>

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="30 Days" android:textColor="#FFFFFF" android:textSize="14sp"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                <TextView android:text="25000 💎" android:textColor="#FFD700" android:textSize="13sp"
                    android:layout_marginEnd="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnR30d" android:text="GET" android:textColor="#000000"
                    android:textSize="11sp" android:textStyle="bold" android:background="@drawable/coin_gold"
                    android:minWidth="0dp" android:paddingHorizontal="18dp"
                    android:layout_width="wrap_content" android:layout_height="38dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PROMO -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/black_gold_card"
            android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="🔐 PROMO CODE" android:textColor="#FFD700"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/etPromo" android:hint="Enter secret code..."
                android:textColorHint="#60FFD700" android:textColor="#FFFFFF" android:textSize="13sp"
                android:padding="12dp" android:background="@drawable/input_bg"
                android:inputType="textCapCharacters" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/btnPromo" android:text="REDEEM" android:textColor="#000000"
                android:textStyle="bold" android:background="@drawable/coin_gold"
                android:layout_width="match_parent" android:layout_height="48dp"/>
        </LinearLayout>

        <Button android:id="@+id/btnBack" android:text="← Back"
            android:textColor="#FFD700" android:background="@drawable/input_bg"
            android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp"/>

    </LinearLayout>
</ScrollView>
