<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_gradient">

    <!-- HEADER -->
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="🌐 MY WEBSITES" android:textSize="20sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:letterSpacing="0.15"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvActiveCount" android:text="0 active"
            android:textColor="#FF00E676" android:textSize="12sp" android:textStyle="bold"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:background="@drawable/card_bg"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ADD URL BAR -->
    <LinearLayout android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/etNewUrl" android:hint="https://site.com"
            android:textColorHint="#60FFFFFF" android:textColor="#FFFFFF" android:textSize="13sp"
            android:padding="12dp" android:background="@drawable/input_bg"
            android:inputType="textUri" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnAdd" android:text="+ ADD"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/btn_gradient" android:layout_marginStart="8dp"
            android:minWidth="0dp" android:paddingHorizontal="18dp"
            android:layout_width="wrap_content" android:layout_height="48dp"/>
    </LinearLayout>

    <!-- TABS -->
    <LinearLayout android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tabActive" android:text="🟢 ACTIVE"
            android:textColor="#000000" android:textStyle="bold" android:textSize="13sp"
            android:gravity="center" android:padding="10dp"
            android:background="@drawable/coin_gold"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/tabHistory" android:text="📜 HISTORY"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:gravity="center" android:padding="10dp"
            android:background="@drawable/input_bg"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvEmpty" android:text="Koi URL nahi hai. Upar URL add karein."
        android:textColor="#90FFFFFF" android:textSize="13sp" android:gravity="center"
        android:padding="40dp" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <ListView android:id="@+id/lvSites"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@null" android:dividerHeight="8dp"
        android:padding="12dp" android:clipToPadding="false"/>

    <!-- BOTTOM BUTTONS -->
    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btnClearHistory" android:text="🗑️ Clear History"
            android:textColor="#FF6B00" android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/input_bg" android:visibility="gone"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"
            android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnStartAll" android:text="▶ START ALL"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
            android:background="@drawable/btn_gradient"
            android:layout_weight="2" android:layout_width="0dp" android:layout_height="56dp"
            android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnBack" android:text="←"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:background="@drawable/input_bg" android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:layout_width="wrap_content" android:layout_height="56dp"/>
    </LinearLayout>
</LinearLayout>
